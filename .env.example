# --- Alpaca (optional) -----------------------------------------------------
# Enables the Stocks tab. Free "Basic" keys from https://alpaca.markets are
# enough: real IEX-venue quotes and daily bars. No trading permission needed,
# since this app never routes real orders.
#
# Uncomment and fill in. While these stay commented out the terminal runs
# crypto-only and the Stocks tab won't respond.
#
#ALPACA_API_KEY_ID=PK...
#ALPACA_API_SECRET_KEY=...

# --- Feed socket (optional) ------------------------------------------------
# Where the feedhandler publishes and the terminal listens. Change both ends
# together, or just pass a port to scripts/run.sh.
#EL_FEED_PORT=5020

# --- Feedhandler tuning (optional) -----------------------------------------
#EL_FLUSH_INTERVAL=0.10    # seconds between tick batches (tick latency floor)
#EL_MAX_BUFFER=1000        # flush early once this many ticks queue up
#EL_RECONNECT_DELAY=2.0    # seconds before retrying a dropped exchange stream

# --- Debug only ------------------------------------------------------------
# Disables TLS certificate verification, for getting past an intercepting
# proxy while developing. Never enable this for anything carrying credentials.
#EL_INSECURE_SSL=0
